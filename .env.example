# Environment variables for local development. Copy this file to `.env`
# (which is gitignored) and fill it in.
#
# On Val's platform these are set in Val Build instead -- the project's
# Variables page, or Settings › Variables in the Studio -- and are read when
# the site runs: no rebuild.
#
# PUBLIC_ names reach the browser, as import.meta.env.NAME. Never put a
# credential in one.
# PUBLIC_API_URL=https://api.example.com

# Everything else is server only, as process.env.NAME: read it in a
# createServerFn handler or a server route, never in a component.
# FEATURE_FLAG=on
# STRIPE_SECRET_KEY=sk_test_...

# Content tools (MCP) in a production build: see "Content tools" in README.md.
# VAL_OAUTH_ISSUER=https://admin.val.build
# VAL_MCP_RESOURCE=https://your-app.com/api/mcp
